<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".app.MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CGPOC"
        tools:targetApi="31">
        <activity
            android:name=".presentation.ui.UserActivity"
            android:exported="false"
            android:label="@string/title_activity_user"
            android:theme="@style/Theme.CGPOC" />
        <activity
            android:name=".presentation.ui.ProductDetilsActivity"
            android:exported="false"
            android:label="@string/title_activity_product_detils"
            android:theme="@style/Theme.CGPOC" />
        <activity
            android:name=".presentation.ui.PersonsActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.ui.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.CGPOC">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.ui.MainActivity"
            android:exported="false"
            android:theme="@style/Base.Theme.CGPOC" />
    </application>

</manifest>